// §6.5 `defer unsafe { ... }` ≡ `defer { unsafe { ... } }`; runs at block exit like any defer.

extern "C" {
    fn strlen(s: Ptr<c::char>) -> c::size_t;
}

fn measure(text: str) -> c::size_t {
    let s = text.to_cstr();
    defer unsafe {
        c::free(s);
        println("freed");
    }
    return unsafe => strlen(s);
}

fn main() {
    println(measure("bolt"));
}
