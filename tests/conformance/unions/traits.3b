// §3.4 traits of unions: a union implements a union-safe trait every member implements, and
// calls dispatch on the runtime member. §16 `null` displays as `null`.
type Json = null | bool | f64 | str | [Json] | Map<str, Json>;

trait Shape {
    fn area(self) -> f64;
    fn grow(mut self);
    fn describe(self) -> str => f"shape of area {self.area()}";
}

struct Square : Shape {
    let side: f64;
    pub fn area(self) -> f64 => self.side * self.side;
    pub fn grow(mut self) { self.side += 1; }
}

class Circle : Shape {
    let r: f64;
    pub fn new(r: f64) -> Self => { r };
    pub fn area(self) -> f64 => 3 * self.r * self.r;
    pub fn grow(mut self) { self.r += 1; }
    pub fn describe(self) -> str => f"circle of radius {self.r}";
}

fn pick(b: bool) -> i32 | str {
    if b { return 1; }
    return "one";
}

fn parse(s: str) -> i32 | Err {
    let n = i32::parse(s);
    if n == null { return error(f"bad number '{s}'"); }
    return n;
}

fn show<T: Display>(label: str, x: T) => println(f"{label}: {x}");

fn total_len(xs: [str | [i32]]) -> usize {
    let mut n: usize = 0;
    for x in xs { n += x.len; }
    return n;
}

fn main() {
    // Display: println, f-strings, to_str, generic bounds, collections of unions.
    let x = pick(false);
    println(x);
    println(f"{pick(true)} and {x}");
    println(x.to_str().len);
    show("picked", pick(true));
    let mixed: [i32 | str | char] = [1, "two", '3'];
    println(mixed);

    // Results and optionals.
    println(parse("12"));
    println(parse("zz"));
    let missing: i32 | null = null;
    println(missing);
    println(f"[{missing}] [{null}]");
    show("null", null);

    // Getters and other std traits.
    let w: str | [i32] = [1, 2, 3];
    println(w.len);
    println(total_len(["ab", [1], "cde"]));

    // Recursive aliases.
    let inner: Map<str, Json> = ["k": 2.0, "none": null];
    let j: Json = [1.5, "a", null, true, inner];
    println(j);

    // User traits, default bodies and overrides; `mut self` updates the union's place.
    let mut s: Square | Circle = Square { side: 2 };
    s.grow();
    println(f"{s.area()} {s.describe()}");
    s = Circle::new(1);
    s.grow();
    println(f"{s.area()} {s.describe()}");
    let shapes: [Square | Circle] = [Square { side: 1 }, Circle::new(2)];
    println(shapes.iter().fold(0.0, (acc, sh) => acc + sh.area()));
}
