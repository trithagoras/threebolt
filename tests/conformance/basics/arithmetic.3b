// §3.6, §7.3, §13.2: numeric literal typing, widening, operators, checked arithmetic.

fn main() {
    let a = 7;                      // i32
    let b: i64 = 3;                 // literal adopts i64
    println(f"{a + b} {a / 2} {a % 3} {-a / 2} {-a % 3}");   // i32 widens to i64
    let big: u64 = 18_446_744_073_709_551_615;
    println(f"{big} {u64::MAX} {i64::MIN} {u8::MAX}");
    let h = 0xFF_u8;
    println(f"{h} {0b1010} {0o17} {1_000_000}");
    println(f"{1 << 4} {256 >> 2} {6 & 3} {6 | 3} {6 ^ 3} {~0}");
    let f = 1.5;
    let g: f32 = 2.25;
    println(f"{f * 2.0} {g} {0.1 + 0.2} {1.0 / 3.0} {1e21} {2.5e-3}");
    println(f"{10.0 / 4.0} {-0.0} {(2.0).sqrt()} {(-1.5).abs()} {1.0 / 0.0}");
    let wide: f64 = a;              // i32 → f64
    println(f"{wide}");
    println(f"{300 as u8} {-1 as u32} {3.99 as i32} {-3.99 as i32} {1e10 as i32} {65 as char} {'a' as u32}");
    println(f"{(250_u8).wrapping_add(10)} {(250_u8).checked_add(10) ?? 0} {(250_u8).saturating_add(10)}");
    println(f"{(-5).abs()} {(3).min(9)} {(3).max(9)} {(2).pow(10)}");
    println(f"{i32::parse("42") ?? -1} {i32::parse("x") ?? -1} {u8::parse("300") ?? 0} {f64::parse("2.5") ?? 0.0}");
    println(f"{5 > 3} {5 == 5} {5 != 5} {'a' < 'b'} {"abc" < "abd"}");
    let mut n = 10;
    n += 5;
    n -= 1;
    n *= 2;
    n /= 4;
    n %= 4;
    n <<= 3;
    n |= 1;
    println(f"{n}");
}
