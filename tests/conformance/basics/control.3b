// §6: if/else, while, loop, for over ranges, break/continue, shadowing, blocks.

fn classify(n: i32) -> str {
    if n < 0 {
        return "negative";
    } else if n == 0 {
        return "zero";
    } else {
        return "positive";
    }
}

fn main() {
    println(f"{classify(-3)} {classify(0)} {classify(8)}");

    let mut total = 0;
    for i in 0..5 {
        total += i;
    }
    for i in 1..=3 {
        total += i * 100;
    }
    println(f"total {total}");

    let mut i = 0;
    while i < 10 {
        i += 1;
        if i % 2 == 0 { continue; }
        if i > 7 { break; }
        print(f"{i} ");
    }
    println("");

    let mut count = 0;
    loop {
        count += 1;
        if count == 3 { break; }
    }
    println(f"count {count}");

    let x = 1;
    {
        let x = x + 10;          // shadows in a nested block
        println(f"inner {x}");
    }
    let x = x * 2;               // shadows in the same scope
    println(f"outer {x}");

    for c in 'a'..='e' { print(f"{c}"); }
    println("");
    let label = "big" if total > 100 else "small";
    println(label);
}
