// §7.14: select works only on std's channels, which can be offered and withdrawn atomically; a
// user type implementing Receiver panics.
//! exit: 101
use std::sync::Receiver;
use std::time::Duration;

class Ones : Receiver<i32> {
    pub fn new() -> Self => {};
    pub fn recv(self) -> i32 => 1;
    pub fn recv(self, timeout: Duration) -> i32 => 1;
    pub fn iter(self) -> Iterator<i32> => [1].iter();
}

fn main() -> () | Err {
    let r: Receiver<i32> = Ones::new();
    println(r.recv()?);
    select { let x = r.recv() => println(x), }?;
}
