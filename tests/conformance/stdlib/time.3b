// §16 std::time: Duration arithmetic and display, Instant and Timestamp, measure, sleep.
use std::time;
use std::time::{Duration, Instant, Timestamp};
use std::thread;

fn main() {
    // Display: the largest unit with a whole part, decimals without trailing zeros.
    let ds = [
        Duration::ZERO, Duration::from_nanos(12), Duration::from_micros(3), Duration::from_nanos(3_250),
        Duration::from_millis(250), Duration::from_millis(1500), Duration::from_secs(90),
        Duration::from_nanos(1_000_000_001), Duration::from_secs(-2), Duration::from_micros(-1_500),
        Duration::MAX, Duration::MIN,
    ];
    println(ds.join(" "));

    // Conversions round toward zero.
    let d = Duration::from_millis(-2_750);
    println(f"{d.as_secs()} {d.as_millis()} {d.as_micros()} {d.as_nanos()} {d.as_secs_f64()}");
    println(Duration::from_secs_f64(0.25));
    println(Duration::from_secs_f64(1e300) == Duration::MAX);
    println(f"{d.is_negative()} {d.abs()} {Duration::ZERO.is_zero()}");

    // Operators and scaling.
    let a = Duration::from_secs(1);
    let b = Duration::from_millis(400);
    println(f"{a + b} {a - b} {b - a} {-a} {b.mul(3)} {a.div(3)}");
    let mut acc = Duration::ZERO;
    for i in 1..=4 { acc += Duration::from_millis(i * 100); }
    println(acc);
    println(f"{a > b} {a == Duration::from_millis(1000)} {a.cmp(b)}");
    let mut seen: Set<Duration> = [];
    seen.insert(a);
    println(seen.contains(Duration::from_nanos(1_000_000_000)));

    // Instant: monotonic; sleep waits at least the duration.
    let start = Instant::now();
    thread::sleep(Duration::from_millis(20));
    thread::sleep(Duration::from_secs(-1));
    let later = Instant::now();
    println(later.since(start) >= Duration::from_millis(20));
    println(start.since(later).is_negative());
    println(start.add(later.since(start)) == later);
    println(later.sub(Duration::from_secs(1)) < start);
    println(start.elapsed() >= later.since(start));

    // Timestamp: the wall clock from the Unix epoch.
    let now = Timestamp::now();
    println(now.since_epoch().as_secs() > 1_700_000_000);
    println(now.since(Timestamp::UNIX_EPOCH) == now.since_epoch());
    println(Timestamp::UNIX_EPOCH.add(Duration::from_secs(86_400)).since_epoch());

    // measure returns the result and how long it took.
    let (r, took) = time::measure(() => {
        thread::sleep(Duration::from_millis(5));
        return 42;
    });
    println(f"{r} {took >= Duration::from_millis(5)}");
}
