// std::io's Read and Write traits (§16): File through trait references and bounds, and user
// types implementing them, getting `lines`, `read_lines`, `write_line` and `flush` for free. An
// implementation may return less than the trait (§4.9): these never time out or get cancelled.
use std::io;
use std::io::{File, Read, Write, IoErr, ModeErr};
use std::thread::CancelledErr;
use std::time::TimedOutErr;

/// Reads from a string, a line at a time.
class StrReader : Read {
    let lines_left: [str];

    pub fn new(s: str) -> Self => { lines_left: s.split("\n") };

    pub fn read(mut self) -> str | IoErr {
        let rest = self.lines_left.join("\n");
        self.lines_left = [];
        return rest;
    }
    pub fn read_line(mut self) -> str | null | IoErr {
        if self.lines_left.len == 0 { return null; }
        return self.lines_left.remove(0);
    }
    pub fn read_bytes(mut self) -> [u8] | IoErr => self.read()?.to_utf8();
    pub fn read_bytes(mut self, n: usize) -> [u8] | IoErr => IoErr::new("not supported");
}

/// Collects what is written.
class Sink : Write {
    pub let text: str = "";

    pub fn new() -> Self => {};

    pub fn write(mut self, s: str) -> () | IoErr { self.text = self.text + s; }
    pub fn write_bytes(mut self, bytes: [u8]) -> () | IoErr => self.write(str::from_utf8(bytes));
}

fn copy_lines(mut from: Read, mut to: Write) -> () | IoErr | TimedOutErr | CancelledErr {
    for line in from.lines() {
        to.write_line(f"> {line?}")?;
    }
    to.flush()?;
}

fn count_lines<R: Read>(mut r: R) -> usize | IoErr | TimedOutErr | CancelledErr => r.read_lines()?.len;

fn main() -> () | Err {
    let sink = Sink::new();
    copy_lines(StrReader::new("one\ntwo"), sink)?;
    print(sink.text);
    println(count_lines(StrReader::new("a\nb\nc"))?);

    let dir = io::temp_dir() + "/threebolt-conformance-io-traits";
    io::create_dirs(dir)?;
    let p = f"{dir}/t.txt";
    let mut out = io::open(p, "w")?;
    copy_lines(StrReader::new("x\ny"), out)?;
    out.write("z")?;
    out.close();
    println(io::read_text(p)?);

    let mut f = io::open(p)?;
    println(count_lines(f)?);
    f.close();

    // A file is a Write too, and an error through the trait is the file's own.
    let mut r = io::open(p)?;
    let w: Write = r;
    let e = copy_lines(StrReader::new("q"), w);
    println(e is ModeErr);
    r.close();

    // A union of readers is a Read (§3.4).
    let either: File | StrReader = StrReader::new("u");
    let mut any: Read = either;
    println(any.read_line());

    io::remove(p)?;
    io::remove(dir)?;
}
