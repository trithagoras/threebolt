// std::net TCP (§16): a loopback echo server on port 0, line and byte reads, the Read/Write
// traits over a socket, shutdown, read timeouts, a refused connection and `serve`.
use std::io::{Read, Write, IoErr, ClosedErr};
use std::net::{TcpListener, TcpStream, SocketAddr, Ipv4Addr, Shutdown, TimedOutErr, ConnectionRefusedErr, NetErr};
use std::thread::Thread;
use std::time::Duration;

fn shout(mut r: Read, mut w: Write) -> () | IoErr {
    for line in r.lines() { w.write_line(line?.upper())?; }
}

fn main() -> () | Err {
    // Echo, a line at a time, on a free port.
    let mut listener = TcpListener::bind("127.0.0.1:0")?;
    let addr = listener.local_addr;
    println(f"{addr.ip} {addr.port > 0}");
    let server = Thread::spawn(() => {
        let mut conn = listener.accept();
        if conn is IoErr { return f"accept: {conn}"; }
        defer conn.close();
        let peer_ok = conn.peer_addr.ip == Ipv4Addr::LOCALHOST && conn.local_addr == addr;
        let r = shout(conn, conn);
        return f"server done {peer_ok} {r is IoErr}";
    });

    let mut client = TcpStream::connect(addr)?;
    client.set_nodelay(true)?;
    println(client.peer_addr == addr);
    client.write_line("hello")?;
    client.write("over ")?;
    client.write("two\r\nthree\n")?;
    println(client.read_line());
    println(client.read_line());
    println(client.read_line());
    client.write_bytes("bytes\n".to_utf8())?;
    println(str::from_utf8(client.read_bytes(6)?));
    client.shutdown(Shutdown::Write)?;
    println(client.read_line());
    println(server.join()?);
    client.close();
    client.close();
    println(client.closed);
    let e = client.read_line();
    println(f"{e is ClosedErr} {(e as IoErr).message().starts_with("socket is closed: 127.0.0.1:")}");

    // `connect` with text looks the host up; a read timeout leaves the stream usable.
    let server = Thread::spawn(() => {
        let mut conn = listener.accept();
        if conn is IoErr { return; }
        defer conn.close();
        _ = std::thread::sleep(Duration::from_millis(300));
        _ = conn.write_line("late");
        _ = conn.read_line();
    });
    let mut c = TcpStream::connect(f"localhost:{addr.port}", timeout: Duration::from_secs(5))?;
    c.set_read_timeout(Duration::from_millis(20))?;
    let t = c.read_line();
    println(f"{t is TimedOutErr} {t is NetErr} {t is IoErr}");
    c.set_read_timeout(null)?;
    println(c.read_line());
    c.close();
    server.join()?;

    // The whole input, until the peer closes.
    let server = Thread::spawn(() => {
        let mut conn = listener.accept();
        if conn is IoErr { return; }
        _ = conn.write("a\nb\nc");
        conn.close();
    });
    let mut c = TcpStream::connect(addr)?;
    println(c.read_lines()?);
    println(c.read_line());
    c.close();
    server.join()?;

    // Nothing listens once the listener is closed.
    listener.close();
    println(listener.closed);
    println(listener.accept() is ClosedErr);
    let refused = TcpStream::connect(addr);
    println(f"{refused is ConnectionRefusedErr} {(refused as IoErr).path == addr.to_str()}");

    // `serve` runs each connection on its own thread until the listener is closed.
    let mut l = TcpListener::bind(SocketAddr::new(Ipv4Addr::LOCALHOST, 0))?;
    let a = l.local_addr;
    let served = Thread::spawn(() => l.serve(conn => { _ = shout(conn, conn); }));
    let mut c1 = TcpStream::connect(a)?;
    let mut c2 = TcpStream::connect(a)?;
    c2.write_line("second")?;
    c1.write_line("first")?;
    println(c1.read_line());
    println(c2.read_line());
    c1.close();
    c2.close();
    l.close();
    println(served.join() is IoErr);

    // A union of streams is a reader.
    let s: std::io::File | TcpStream = std::io::stdin();
    let mut r: Read = s;
    println(r.read_line());
}
