use std::json;
use std::json::{Json, FromJson};

struct Point { let x: f64; }

struct Bad : FromJson {
    // The parameters must match the trait's exactly (the result may be narrower, §4.9).
    pub fn from_json(j: str) -> Self => Bad {};
}

fn main() -> () | Err {
    // Point implements neither trait.
    let p = json::decode<Point>("{}")?;
    println(json::encode(Point { x: 1.0 }));
    // A parse result may be an error.
    json::parse("1");
    // Json is a union: no ToJson.
    let j: Json = null;
    println(json::encode(j));
}
