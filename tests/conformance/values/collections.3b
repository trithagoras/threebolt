// §7.7, §16: lists, maps, sets, fixed arrays; literals are target-typed; Truthy and Len.

fn main() {
    let mut xs = [3, 1, 2];
    xs.push(4);
    println(f"{xs.len} {xs[0]} {len(xs)} {xs.first ?? 0} {xs.last ?? 0}");
    println(f"{xs.pop() ?? -1} {xs.len} {xs.contains(2)} {xs.remove(0)} {xs.len}");
    xs.insert(0, 9);
    let mut sum = 0;
    for x in xs { sum += x; }
    println(f"sum {sum}");
    for (i, x) in xs.enumerate() { print(f"{i}:{x} "); }
    println("");

    let empty: [str] = [];
    if !empty { println("empty list is falsy"); }

    let mut ages: Map<str, i32> = ["ann": 31, "bob": 25];
    ages["cat"] = 40;
    ages["ann"] += 1;
    println(f"{ages.len} {ages["ann"]} {ages.get("zed") ?? -1} {ages.contains_key("bob")}");
    for (name, age) in ages { print(f"{name}={age} "); }
    println("");
    _ = ages.remove("bob");
    for k in ages.keys { print(f"{k} "); }
    println("");

    let mut seen: Set<i32> = [1, 2, 2, 3];
    println(f"{seen.len} {seen.insert(3)} {seen.insert(4)} {seen.contains(4)}");

    let mut grid: [i32; 3] = [0; 3];
    grid[1] = 5;
    let g2 = grid;              // arrays are values
    grid[2] = 7;
    println(f"{grid[1]} {grid[2]} {g2[2]} {grid.len}");

    let words = ["x"; 2];
    println(f"{words.len} {words[1]}");
    let nums = [1, 2, 3, 4, 5, 6].iter().filter(n => n % 2 == 0).map(n => n * 10).to_list();
    println(f"{nums.len} {nums[0]} {nums[2]}");
    let total = [1, 2, 3].iter().fold(0, (acc, n) => acc + n);
    println(f"{total} {[1, 2, 3].iter().any(n => n > 2)} {[1, 2, 3].iter().all(n => n > 2)} {[1, 2].iter().count()}");
}
