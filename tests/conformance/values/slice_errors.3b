// Compile errors for slicing (§7.6).

fn main() {
    let mut xs = [1, 2, 3];
    xs[1..3] = [5];                       // a slice is not a place
    xs[1..] = [5];
    _ = "hello"[1..];                     // only lists and arrays
    let m: Map<str, i32> = [:];
    _ = m[..];
    let i: i32 = 1;
    _ = xs[i..];                          // bounds are usize
}
