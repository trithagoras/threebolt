// §7.6: slicing lists and arrays with closed and open-ended ranges; slices are copies.

struct P { pub let x: i32; }

fn sum(xs: [i32]) -> i32 => match xs {
    [] => 0,
    _ => xs[0] + sum(xs[1..]),
};

fn main() {
    let xs = [10, 20, 30, 40];
    println(f"{xs[1..3].len} {xs[1..3][0]} {xs[1..=3].len} {xs[1..].len} {xs[..2].len} {xs[..=2].len} {xs[..].len}");
    println(f"{xs[4..].len} {xs[2..2].len} {xs[..0].len}");

    let n: usize = 3;
    println(f"{xs[n..][0]} {xs[..n][n - 1]}");

    let arr: [i32; 4] = [1, 2, 3, 4];
    let tail = arr[1..];                  // a `[i32]`
    println(f"{tail.len} {tail[0]} {tail.type()}");

    let ps = [P { x: 1 }, P { x: 2 }];
    let mut copy = ps[..];
    copy.push(P { x: 3 });
    println(f"{ps.len} {copy.len}");

    println(sum([1, 2, 3, 4, 5]));
}
