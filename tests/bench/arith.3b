// Integer and float arithmetic in tight loops: a sieve and a Mandelbrot count.

fn main() {
    let n: usize = 2000000;
    let mut sieve: [bool] = [];
    for _ in 0..n { sieve.push(true); }
    let mut primes = 0;
    for i in 2..n {
        if sieve[i] {
            primes += 1;
            let mut j = i * i;
            while j < n {
                sieve[j] = false;
                j += i;
            }
        }
    }

    let mut inside = 0;
    for py in 0..180 {
        for px in 0..240 {
            let cx = (px as f64) / 120.0 - 1.5;
            let cy = (py as f64) / 90.0 - 1.0;
            let mut x = 0.0;
            let mut y = 0.0;
            let mut k = 0;
            while k < 100 && x * x + y * y < 4.0 {
                let t = x * x - y * y + cx;
                y = 2.0 * x * y + cy;
                x = t;
                k += 1;
            }
            if k == 100 { inside += 1; }
        }
    }
    println(f"{primes} {inside}");
}
