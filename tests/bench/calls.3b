// Function calls, method dispatch through a trait, and closures.

trait Shape { fn area(self) -> f64; }

struct Square : Shape {
    let side: f64;
    pub fn area(self) -> f64 => self.side * self.side;
}

class Circle : Shape {
    let r: f64;
    pub fn new(r: f64) -> Self => { r: r };
    pub fn area(self) -> f64 => 3.0 * self.r * self.r;
}

fn fib(n: i32) -> i64 {
    if n < 2 { return n as i64; }
    return fib(n - 1) + fib(n - 2);
}

fn apply(f: fn(i64) -> i64, x: i64) -> i64 => f(x);

fn main() {
    let f = fib(30);

    let mut shapes: [Shape] = [];
    for i in 0..1000 {
        if i % 2 == 0 { shapes.push(Square { side: i as f64 }); } else { shapes.push(Circle::new(i as f64)); }
    }
    let mut area = 0.0;
    for _ in 0..1000 {
        for s in shapes { area += s.area(); }
    }

    let k: i64 = 3;
    let mut acc: i64 = 0;
    for i in 0..1000000 { acc = apply(x => x * k + 1, i) % 1000003 + acc % 7; }
    println(f"{f} {area} {acc}");
}
