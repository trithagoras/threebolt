// Members of every integer type (spec §16); `Self` is the integer type. Not a module: the
// checker attaches these members to the primitive types. Bodyless members are intrinsics; the
// others are checked once per integer type.

/// The value `n`; panics if it does not fit.
pub fn from_i64(n: i64) -> Self;
/// `0`.
pub fn zero() -> Self => 0;
/// `1`.
pub fn one() -> Self => 1;
/// The smallest value (`MIN`).
pub fn min_value() -> Self => Self::MIN;
/// The largest value (`MAX`).
pub fn max_value() -> Self => Self::MAX;
/// The width in bits.
pub fn bits() -> u32;

/// The absolute value; `MIN.abs()` overflows and panics (§13.2).
pub fn abs(self) -> Self => 0 - self if self < 0 else self;
/// The smaller of `self` and `o`.
pub fn min(self, o: Self) -> Self => self if self <= o else o;
/// The larger of `self` and `o`.
pub fn max(self, o: Self) -> Self => self if self >= o else o;
/// `self` raised to `exp`; overflow panics (§13.2).
pub fn pow(self, exp: u32) -> Self {
    // By squaring; the base is squared only while bits remain, so it overflows only if the result does.
    let mut result: Self = 1;
    let mut base = self;
    let mut e = exp;
    while e > 0 {
        if (e & 1) == 1 { result = result * base; }
        e = e >> 1;
        if e > 0 { base = base * base; }
    }
    return result;
}

/// `self + o`, wrapping around on overflow.
pub fn wrapping_add(self, o: Self) -> Self;
/// `self - o`, wrapping around on overflow.
pub fn wrapping_sub(self, o: Self) -> Self;
/// `self * o`, wrapping around on overflow.
pub fn wrapping_mul(self, o: Self) -> Self;
/// `-self`, wrapping around on overflow (`MIN` stays `MIN`).
pub fn wrapping_neg(self) -> Self;
/// `self << n`, with `n` taken modulo the width.
pub fn wrapping_shl(self, n: u32) -> Self;
/// `self >> n`, with `n` taken modulo the width.
pub fn wrapping_shr(self, n: u32) -> Self;
/// `self + o`, or `null` on overflow.
pub fn checked_add(self, o: Self) -> Self | null;
/// `self - o`, or `null` on overflow.
pub fn checked_sub(self, o: Self) -> Self | null;
/// `self * o`, or `null` on overflow.
pub fn checked_mul(self, o: Self) -> Self | null;
/// `-self`, or `null` on overflow.
pub fn checked_neg(self) -> Self | null;
/// `self << n`, or `null` if `n` is not less than the width.
pub fn checked_shl(self, n: u32) -> Self | null;
/// `self >> n`, or `null` if `n` is not less than the width.
pub fn checked_shr(self, n: u32) -> Self | null;
/// `self + o`, clamped to `MIN..=MAX`.
pub fn saturating_add(self, o: Self) -> Self;
/// `self - o`, clamped to `MIN..=MAX`.
pub fn saturating_sub(self, o: Self) -> Self;
/// `self * o`, clamped to `MIN..=MAX`.
pub fn saturating_mul(self, o: Self) -> Self;
/// `-self`, clamped to `MIN..=MAX`.
pub fn saturating_neg(self) -> Self;
/// `self << n`; `0` if `n` is not less than the width.
pub fn saturating_shl(self, n: u32) -> Self;
/// `self >> n`; `0` (or `-1` for a negative value) if `n` is not less than the width.
pub fn saturating_shr(self, n: u32) -> Self;

/// The decimal number in `s` (an optional sign, then digits), or `null` if `s` is not one or the
/// value does not fit.
pub fn parse(s: str) -> Self | null {
    let n = s.len;
    let negative = n > 0 && s[0] == '-';
    let mut i: usize = 1 if n > 0 && (negative || s[0] == '+') else 0;
    if i == n { return null; }
    // Negative numbers accumulate downwards, so `MIN` (and `-0` for unsigned types) fit.
    let ten: Self = 10;
    let mut value: Self = 0;
    while i < n {
        let c = s[i];
        if !c.is_digit() { return null; }
        let digit = Self::from_i64((c as i64) - ('0' as i64));
        let shifted = value.checked_mul(ten);
        if shifted == null { return null; }
        let next = shifted.checked_sub(digit) if negative else shifted.checked_add(digit);
        if next == null { return null; }
        value = next;
        i += 1;
    }
    return value;
}
/// The value in decimal.
pub fn to_str(self) -> str;
pub fn eq(self, o: Self) -> bool => self == o;
pub fn cmp(self, o: Self) -> Ordering => "less" if self < o else ("greater" if self > o else "equal");
pub fn hash(self) -> u64;

pub fn add(self, o: Self) -> Self => self + o;
pub fn sub(self, o: Self) -> Self => self - o;
pub fn mul(self, o: Self) -> Self => self * o;
/// Integer division, rounding towards zero; dividing by zero panics.
pub fn div(self, o: Self) -> Self => self / o;
/// The remainder of `div`, with the sign of `self`; by zero panics.
pub fn rem(self, o: Self) -> Self => self % o;
/// `-self`; overflows (and panics) for `MIN`, and for any non-zero unsigned value.
pub fn neg(self) -> Self => 0 - self;
pub fn bitand(self, o: Self) -> Self => self & o;
pub fn bitor(self, o: Self) -> Self => self | o;
pub fn bitxor(self, o: Self) -> Self => self ^ o;
pub fn not(self) -> Self => ~self;
pub fn shl(self, o: Self) -> Self => self << o;
pub fn shr(self, o: Self) -> Self => self >> o;
