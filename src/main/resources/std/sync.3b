// std::sync (spec §13.4): locks, atomics, semaphores and channels.

use std::io::ClosedErr;
use std::thread::CancelledErr;
use std::time::{Duration, TimedOutErr};

/// A value shared between threads, accessed under a lock.
pub class Mutex<T> {
    let value: T;
    let raw: RawLock;

    pub fn new(value: T) -> Self => { value, raw: RawLock::new() };
    /// Runs `f` with the lock held. The guard is valid only during `f`; its `value` is stored
    /// back into the mutex when `f` returns. Locking a mutex the thread already holds panics.
    pub fn lock<R>(self, f: fn(Guard<T>) -> R) -> R {
        self.raw.acquire();
        defer self.raw.release();
        let guard = guard(self.value);
        let result = f(guard);
        // `lock` takes `self`, as locking is not mutation; store through a mutable binding (§5.2).
        let mut me = self;
        me.value = guard.value;
        return result;
    }
}

/// Access to a locked `Mutex`'s value (§13.4).
pub class Guard<T> {
    pub let value: T;
}

/// An integer or `bool` with atomic, sequentially consistent operations. The `fetch_*`
/// operations return the previous value; arithmetic wraps.
pub class Atomic<T> {
    pub fn new(value: T) -> Self;
    pub fn load(self) -> T;
    pub fn store(self, value: T);
    pub fn swap(self, value: T) -> T;
    /// Stores `desired` if the value is `expected`; returns the previous value either way, so it
    /// succeeded iff the result equals `expected`.
    pub fn compare_exchange(self, expected: T, desired: T) -> T;
    pub fn fetch_add(self, value: T) -> T;
    pub fn fetch_sub(self, value: T) -> T;
    pub fn fetch_and(self, value: T) -> T;
    pub fn fetch_or(self, value: T) -> T;
    pub fn fetch_xor(self, value: T) -> T;
}

/// Limits how many threads run something at once.
pub class Semaphore {
    /// A semaphore with `permits` permits.
    pub fn new(permits: usize) -> Self;

    /// Takes a permit, waiting while none is free, runs `f`, and gives the permit back however
    /// `f` exits. Only the wait is a cancellation point.
    pub fn with<R>(self, f: fn() -> R) -> R | CancelledErr {
        if !self.acquire() { return CancelledErr::new(); }
        defer self.release();
        return f();
    }

    /// Takes a permit, waiting while none is free; false if the thread is cancelled first or meanwhile.
    fn acquire(self) -> bool;
    fn release(self);
}

/// The sending side of a channel. Only senders close.
pub trait Sender<T> {
    /// Sends `v`, waiting while the channel is full (unbuffered: until a receiver takes it).
    /// `ClosedErr` if the channel is closed, also while waiting.
    fn send(self, v: T) -> () | ClosedErr | CancelledErr;
    /// Sends `v` if that needs no wait; false when the channel is full or closed.
    fn try_send(self, v: T) -> bool;
    /// Closes the channel: further sends fail, and receivers get what is left, then `ClosedErr`.
    /// Closing again does nothing.
    fn close(self);
}

/// The receiving side of a channel. Iterating yields items until the channel is closed and
/// drained; on cancellation it yields `CancelledErr` once and ends.
pub trait Receiver<T> : Iterable<T | CancelledErr> {
    /// The next item, waiting while there is none; `ClosedErr` once the channel is closed and drained.
    fn recv(self) -> T | ClosedErr | CancelledErr;
    /// As `recv()`, giving up after `timeout` (a zero or negative `timeout` checks once).
    fn recv(self, timeout: Duration) -> T | ClosedErr | TimedOutErr | CancelledErr;
}

// What a channel operation reports; keep in step with `Channels.java`.
const OP_DONE: i32 = 0;
const OP_CLOSED: i32 = 1;
const OP_TIMED_OUT: i32 = 2;
const OP_CANCELLED: i32 = 3;

/// A FIFO queue between threads, holding up to `capacity` items (none: each `send` waits for a
/// `recv`).
pub class Channel<T> : Sender<T>, Receiver<T> {
    /// An unbuffered channel: each `send` waits for a `recv`.
    pub fn new() -> Self => Channel<T>::new(0);
    /// A channel holding up to `capacity` items (`new(0)` is unbuffered).
    pub fn new(capacity: usize) -> Self;

    pub fn send(self, v: T) -> () | ClosedErr | CancelledErr {
        let r = self.op_send(v, i64::MAX, true);
        if r == OP_CLOSED { return closed(); }
        if r == OP_CANCELLED { return CancelledErr::new(); }
    }

    pub fn try_send(self, v: T) -> bool => self.op_send(v, 0, false) == OP_DONE;

    pub fn close(self);

    pub fn recv(self) -> T | ClosedErr | CancelledErr {
        let r = self.op_recv(i64::MAX);
        if r == OP_CLOSED { return closed(); }
        if r == OP_CANCELLED { return CancelledErr::new(); }
        return self.received();
    }

    pub fn recv(self, timeout: Duration) -> T | ClosedErr | TimedOutErr | CancelledErr {
        let r = self.op_recv(timeout.nanos);
        if r == OP_CLOSED { return closed(); }
        if r == OP_TIMED_OUT { return TimedOutErr::new(); }
        if r == OP_CANCELLED { return CancelledErr::new(); }
        return self.received();
    }

    pub fn iter(self) -> Iterator<T | CancelledErr> => ChannelIter::new(self);

    /// The number of items waiting in the buffer.
    pub get fn len(self) -> usize;
    pub get fn capacity(self) -> usize;
    pub get fn closed(self) -> bool;

    /// Sends `v`, waiting up to `nanos` (`i64::MAX`: forever; at most zero: no wait); an `OP_*`
    /// code. `cancellable`: a cancellation point (`try_send` is not).
    fn op_send(self, v: T, nanos: i64, cancellable: bool) -> i32;
    /// Receives, waiting up to `nanos` as `op_send` does; an `OP_*` code, and on `OP_DONE` the item
    /// is `received()`. A cancellation point.
    fn op_recv(self, nanos: i64) -> i32;
    /// The item the current thread's last `op_recv` on this channel took.
    fn received(self) -> T;
}

fn closed() -> ClosedErr => ClosedErr::new(null, what: "channel");

/// A channel's items until it is closed and drained; `CancelledErr` once on cancellation.
class ChannelIter<T> : Iterator<T | CancelledErr> {
    let ch: Channel<T>;
    let done: bool = false;

    pub fn new(ch: Channel<T>) -> Self => { ch };

    pub fn next(mut self) -> T | CancelledErr | Done {
        if self.done { return Done; }
        let r = self.ch.recv();
        if r is ClosedErr {
            self.done = true;
            return Done;
        }
        if r is CancelledErr { self.done = true; }
        return r;
    }
}

/// A new guard over `value`. An intrinsic only because a class initializer may appear only in its own
/// body and `Guard` has no public constructor.
fn guard<T>(value: T) -> Guard<T>;

/// A lock that one thread holds at a time; not reentrant. The building block of `Mutex`.
class RawLock {
    pub fn new() -> Self;
    /// Waits until the lock is free and takes it; panics if this thread already holds it.
    pub fn acquire(self);
    /// Frees the lock, which this thread holds.
    pub fn release(self);
}
