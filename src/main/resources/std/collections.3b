// std::collections (spec §16). Map and Set are also in the prelude. Iteration follows insertion
// order.

pub class Map<K: Hash + Eq, V> : Len, Truthy, Iterable<(K, V)>, Contains<K>, Index<K, V>, IndexMut<K, V> {
    pub get fn len(self) -> usize;
    pub fn truthy(self) -> bool;
    pub fn iter(self) -> Iterator<(K, V)>;
    pub fn index(self, k: K) -> V;
    pub fn set(mut self, k: K, v: V);
    pub fn get(self, k: K) -> V | null;
    pub fn contains_key(self, k: K) -> bool;
    /// `k in map` tests the keys (§7.3).
    pub fn contains(self, k: K) -> bool => self.contains_key(k);
    pub fn remove(mut self, k: K) -> V | null;
    pub fn clear(mut self);
    pub get fn keys(self) -> Iterator<K>;
    pub get fn values(self) -> Iterator<V>;
}

pub class Set<T: Hash + Eq> : Len, Truthy, Iterable<T>, Contains<T> {
    pub get fn len(self) -> usize;
    pub fn truthy(self) -> bool;
    pub fn iter(self) -> Iterator<T>;
    pub fn insert(mut self, v: T) -> bool;
    pub fn contains(self, v: T) -> bool;
    pub fn remove(mut self, v: T) -> bool;
    pub fn clear(mut self);
}

// impls
impl<K: Display + Hash + Eq, V: Display> Display for Map<K, V> {
    pub fn to_str(self) -> str {
        let mut result = "{ ";
        let mut first = true;

        for (k, v) in self {
            if !first {
                result = result + ", ";
            }

            let keyWrap = match k {
                is str => "\"",
                is char => "'",
                _ => ""
            };

            let valWrap = match v {
                is str => "\"",
                is char => "'",
                _ => ""
            };

            result = result
                + keyWrap + k.to_str() + keyWrap
                + ": "
                + valWrap + v.to_str() + valWrap;

            first = false;
        }

        if first {
            return "{}";
        }

        return result + " }";
    }
}

impl<T: Display + Hash + Eq> Display for Set<T> {
    pub fn to_str(self) -> str {
        let mut result = "{";
        let mut first = true;
        for x in self {
            if !first { result = result + ", "; }
            let wrapChar = match x {
                is str => "\"",
                is char => "'",
                _ => ""
            };
            result = result + wrapChar + x.to_str() + wrapChar;
            first = false;
        }
        return result + "}";
    }
}
