// std::math: Python-style mathematical functions (spec §16). The float functions take `f64`, so
// integers and `f32` widen into them (`math::sqrt(2)`, §3.6); `clamp`, `gcd` and `lcm` are generic
// (§10.1). Floats also have methods for the common ones (`x.sqrt()`); these are the free-function
// forms, plus the functions floats lack.

/// π, the ratio of a circle's circumference to its diameter.
pub const PI: f64 = 3.141592653589793;
/// e, the base of natural logarithms.
pub const E: f64 = 2.718281828459045;
/// τ = 2π.
pub const TAU: f64 = 6.283185307179586;
/// Positive infinity.
pub const INF: f64 = f64::INFINITY;
/// Not a number.
pub const NAN: f64 = f64::NAN;

// ---- Rounding and parts ----

/// The largest integer value not above `x`.
pub fn floor(x: f64) -> f64 => x.floor();
/// The smallest integer value not below `x`.
pub fn ceil(x: f64) -> f64 => x.ceil();
/// The integer part of `x`, rounding towards zero.
pub fn trunc(x: f64) -> f64 => x.trunc();
/// Rounds half away from zero.
pub fn round(x: f64) -> f64 => x.round();
/// `x` with the sign of `y`.
pub fn copysign(x: f64, y: f64) -> f64;
/// The remainder of `x / y` with the sign of `x` (C `fmod`, like `%`).
pub fn fmod(x: f64, y: f64) -> f64 => x % y;
/// The fractional and integral parts of `x`, both with the sign of `x`.
pub fn modf(x: f64) -> (f64, f64) {
    let whole = x.trunc();
    return (x - whole, whole);
}
/// `x` limited to `lo..=hi`, for any number type.
pub fn clamp<T: Num>(x: T, lo: T, hi: T) -> T => lo.max(hi.min(x));

/// Whether `x` is `NaN`.
pub fn isnan(x: f64) -> bool => x.is_nan();
/// Whether `x` is positive or negative infinity.
pub fn isinf(x: f64) -> bool => x.is_infinite();
/// Whether `x` is neither infinite nor `NaN`.
pub fn isfinite(x: f64) -> bool => !x.is_nan() && !x.is_infinite();

/// Whether `a` and `b` are within `rel_tol` of each other relative to the larger magnitude, or
/// within `abs_tol` absolutely.
pub fn isclose(a: f64, b: f64, rel_tol: f64 = 1e-9, abs_tol: f64 = 0.0) -> bool {
    if a == b { return true; }
    if isinf(a) || isinf(b) { return false; }
    let diff = (a - b).abs();
    return diff <= (rel_tol * b).abs() || diff <= (rel_tol * a).abs() || diff <= abs_tol;
}

// ---- Powers and logarithms ----

/// `x` raised to `y`.
pub fn pow(x: f64, y: f64) -> f64 => x.pow(y);
/// The square root; `NaN` for negative numbers.
pub fn sqrt(x: f64) -> f64 => x.sqrt();
/// The cube root.
pub fn cbrt(x: f64) -> f64;
/// `e` raised to `x`.
pub fn exp(x: f64) -> f64 => x.exp();
/// `2` raised to `x`.
pub fn exp2(x: f64) -> f64 => pow(2.0, x);
/// `exp(x) - 1`, accurate for small `x`.
pub fn expm1(x: f64) -> f64;
/// The logarithm of `x` to `base` (natural by default): `math::log(8, base: 2)`.
pub fn log(x: f64, base: f64 = E) -> f64 {
    if base == E { return x.ln(); }
    return x.ln() / base.ln();
}
/// The base-2 logarithm.
pub fn log2(x: f64) -> f64;
/// The base-10 logarithm.
pub fn log10(x: f64) -> f64 => x.log10();
/// `ln(1 + x)`, accurate for small `x`.
pub fn log1p(x: f64) -> f64;

// ---- Trigonometry (radians) ----

/// The sine of `x` radians.
pub fn sin(x: f64) -> f64 => x.sin();
/// The cosine of `x` radians.
pub fn cos(x: f64) -> f64 => x.cos();
/// The tangent of `x` radians.
pub fn tan(x: f64) -> f64 => x.tan();
/// The arc sine, in radians (`-PI/2..=PI/2`).
pub fn asin(x: f64) -> f64;
/// The arc cosine, in radians (`0..=PI`).
pub fn acos(x: f64) -> f64;
/// The arc tangent, in radians (`-PI/2..=PI/2`).
pub fn atan(x: f64) -> f64;
/// The angle of the point `(x, y)` from the positive x axis, in `-PI..=PI`.
pub fn atan2(y: f64, x: f64) -> f64;
/// `sqrt(x*x + y*y)` without intermediate overflow.
pub fn hypot(x: f64, y: f64) -> f64;
/// `rad` radians in degrees.
pub fn degrees(rad: f64) -> f64 => rad * (180.0 / PI);
/// `deg` degrees in radians.
pub fn radians(deg: f64) -> f64 => deg * (PI / 180.0);

pub fn sinh(x: f64) -> f64;
pub fn cosh(x: f64) -> f64;
pub fn tanh(x: f64) -> f64;
pub fn asinh(x: f64) -> f64;
pub fn acosh(x: f64) -> f64;
pub fn atanh(x: f64) -> f64;

// ---- Sums ----

/// The sum of `xs`, compensated (Neumaier) so rounding errors do not accumulate.
pub fn fsum(xs: [f64]) -> f64 {
    let mut sum = 0.0;
    let mut c = 0.0;
    for x in xs {
        let t = sum + x;
        if sum.abs() >= x.abs() {
            c += (sum - t) + x;
        } else {
            c += (x - t) + sum;
        }
        sum = t;
    }
    return sum + c;
}

// ---- Integers ----

/// The greatest common divisor, always non-negative; `gcd(0, 0)` is `0`.
pub fn gcd<T: Integer>(a: T, b: T) -> T {
    let mut x = a.abs();
    let mut y = b.abs();
    while y != 0 {
        let r = x % y;
        x = y;
        y = r;
    }
    return x;
}

/// The least common multiple, always non-negative; `0` if either argument is.
pub fn lcm<T: Integer>(a: T, b: T) -> T {
    if a == 0 || b == 0 { return T::zero(); }
    return (a / gcd(a, b) * b).abs();
}

/// The integer square root: the largest `r` with `r * r <= n`.
pub fn isqrt(n: u64) -> u64;
/// `n!`; panics if the result does not fit in a `u64` (`n > 20`).
pub fn factorial(n: u64) -> u64;
/// The number of ways to choose `k` of `n` items without order; `0` if `k > n`. Panics if the
/// result does not fit in a `u64`.
pub fn comb(n: u64, k: u64) -> u64;
/// The number of ways to choose `k` of `n` items in order; `0` if `k > n`. Panics if the result
/// does not fit in a `u64`.
pub fn perm(n: u64, k: u64) -> u64;
