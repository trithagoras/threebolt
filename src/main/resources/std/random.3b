// std::random: pseudo-random numbers in the style of Python's `random` module (spec §16).
//
// `Random` is a xoshiro256** generator seeded through splitmix64, so a seeded generator produces
// the same sequence on every platform. It is not suitable for cryptography. The free functions
// share one generator seeded from the OS at first use; like any mutable static it is
// unsynchronized (§4.2), so threads that need reproducible or independent streams should each
// make their own `Random`.
//
// The integer functions work for every integer type: `randint(1, 6)` is an `i32`, and
// `let b: u8 = random::randint(0, 255);` a `u8` (§10). Ranges given by two bounds are checked: an empty range, an empty list or a sample larger than
// its population panics.

pub class Random {
    let s0: u64 = 0;
    let s1: u64 = 0;
    let s2: u64 = 0;
    let s3: u64 = 0;

    /// A generator seeded from the operating system's entropy source.
    pub fn new() -> Self => Random::new(entropy());

    /// A generator whose sequence is determined by `seed`.
    pub fn new(seed: u64) -> Self {
        let mut r: Random = {};
        r.seed(seed);
        return r;
    }

    /// Restarts the sequence from `seed`.
    pub fn seed(mut self, seed: u64) {
        let golden: u64 = 0x9e3779b97f4a7c15;
        let mut x = seed;
        x = x.wrapping_add(golden);
        self.s0 = splitmix(x);
        x = x.wrapping_add(golden);
        self.s1 = splitmix(x);
        x = x.wrapping_add(golden);
        self.s2 = splitmix(x);
        x = x.wrapping_add(golden);
        self.s3 = splitmix(x);
    }

    /// 64 uniformly random bits.
    pub fn next_u64(mut self) -> u64 {
        let result = rotl(self.s1.wrapping_mul(5), 7).wrapping_mul(9);
        let t = self.s1 << 17;
        self.s2 ^= self.s0;
        self.s3 ^= self.s1;
        self.s1 ^= self.s2;
        self.s0 ^= self.s3;
        self.s2 ^= t;
        self.s3 = rotl(self.s3, 45);
        return result;
    }

    /// An integer of `k` random bits (`k <= 64`).
    pub fn getrandbits(mut self, k: u32) -> u64 {
        if k > 64 { panic(f"getrandbits: {k} bits is more than 64"); }
        if k == 0 { return 0; }
        return self.next_u64() >> (64 - k);
    }

    /// A float in `0.0..1.0` (never `1.0`), with 53 random bits.
    pub fn random(mut self) -> f64 => (self.next_u64() >> 11) as f64 / 9007199254740992.0;

    /// A float between `a` and `b`.
    pub fn uniform(mut self, a: f64, b: f64) -> f64 => a + (b - a) * self.random();

    /// An integer in `a..=b`.
    pub fn randint<T: Integer>(mut self, a: T, b: T) -> T {
        if a > b { panic(f"randint: empty range {a}..={b}"); }
        // Two's complement in u64: the distance is exact for every integer type.
        let span = (b as u64).wrapping_sub(a as u64).wrapping_add(1);
        if span == 0 { return self.next_u64() as T; } // the whole 64-bit range
        return (a as u64).wrapping_add(self.below(span)) as T;
    }

    /// An integer in `0..stop`.
    pub fn randrange<T: Integer>(mut self, stop: T) -> T => self.randrange(T::zero(), stop);

    /// An integer from `start`, `start + step`, ... that is before `stop`.
    pub fn randrange<T: Integer>(mut self, start: T, stop: T, step: T = 1) -> T {
        if step == 0 { panic("randrange: step is zero"); }
        if (step > 0 && start >= stop) || (step < 0 && start <= stop) {
            panic(f"randrange: empty range ({start}, {stop}, step {step})");
        }
        // As in randint, distances in u64 cannot overflow.
        let s = step as u64;
        if step > 0 {
            let n = ((stop as u64).wrapping_sub(start as u64) - 1) / s + 1;
            return (start as u64).wrapping_add(s.wrapping_mul(self.below(n))) as T;
        }
        let n = ((start as u64).wrapping_sub(stop as u64) - 1) / s.wrapping_neg() + 1;
        return (start as u64).wrapping_sub(s.wrapping_neg().wrapping_mul(self.below(n))) as T;
    }

    /// `true` with probability `p`.
    pub fn chance(mut self, p: f64) -> bool => self.random() < p;

    /// A normally distributed float with mean `mu` and standard deviation `sigma`.
    pub fn gauss(mut self, mu: f64, sigma: f64) -> f64 {
        // Box-Muller; 1 - random() is in 0.0 exclusive to 1.0 inclusive, so ln is finite.
        let u1 = 1.0 - self.random();
        let u2 = self.random();
        return mu + sigma * (-2.0 * u1.ln()).sqrt() * (6.283185307179586 * u2).cos();
    }

    /// An exponentially distributed float with rate `lambd` (mean `1 / lambd`).
    pub fn expovariate(mut self, lambd: f64) -> f64 => -(1.0 - self.random()).ln() / lambd;

    /// A random element of `xs`.
    pub fn choice<T>(mut self, xs: [T]) -> T {
        if xs.len == 0 { panic("choice: empty list"); }
        return xs[self.index(xs.len)];
    }

    /// `k` elements of `xs` chosen with replacement, each with probability proportional to its
    /// weight when `weights` is given (one non-negative weight per element).
    pub fn choices<T>(mut self, xs: [T], k: usize = 1, weights: [f64] | null = null) -> [T] {
        if xs.len == 0 { panic("choices: empty list"); }
        let mut out: [T] = [];
        if weights == null {
            for _ in 0..k { out.push(xs[self.index(xs.len)]); }
            return out;
        }
        if weights.len != xs.len {
            panic(f"choices: {weights.len} weights for {xs.len} elements");
        }
        let mut cumulative: [f64] = [];
        let mut total = 0.0;
        for w in weights {
            total += w;
            cumulative.push(total);
        }
        if !(total > 0.0) { panic("choices: the weights do not add up to a positive number"); }
        for _ in 0..k {
            // The first element whose cumulative weight exceeds a point in 0..total.
            let point = self.random() * total;
            let mut lo: usize = 0;
            let mut hi = xs.len - 1;
            while lo < hi {
                let mid = (lo + hi) / 2;
                if point < cumulative[mid] {
                    hi = mid;
                } else {
                    lo = mid + 1;
                }
            }
            out.push(xs[lo]);
        }
        return out;
    }

    /// Shuffles `xs` in place.
    pub fn shuffle<T>(mut self, mut xs: [T]) {
        let mut i = xs.len;
        while i > 1 {
            let j = self.index(i);
            i -= 1;
            let t = xs[i];
            xs[i] = xs[j];
            xs[j] = t;
        }
    }

    /// `k` distinct elements of `xs` (distinct by position) in random order.
    pub fn sample<T>(mut self, xs: [T], k: usize) -> [T] {
        if k > xs.len { panic(f"sample: {k} elements from a list of {xs.len}"); }
        let mut pool = xs[..];
        for i in 0..k {
            let j = i + self.index(pool.len - i);
            let t = pool[i];
            pool[i] = pool[j];
            pool[j] = t;
        }
        return pool[..k];
    }

    /// A uniformly random integer in `0..n` (`n > 0`), by rejection so there is no modulo bias.
    fn below(mut self, n: u64) -> u64 {
        let threshold = n.wrapping_neg() % n;
        loop {
            let r = self.next_u64();
            if r >= threshold { return r % n; }
        }
    }

    fn index(mut self, n: usize) -> usize => self.below(n as u64) as usize;
}

fn splitmix(x: u64) -> u64 {
    let mut z = x;
    z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);
    z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111eb);
    return z ^ (z >> 31);
}

fn rotl(x: u64, k: u32) -> u64 => (x << k) | (x >> (64 - k));

/// 64 bits from the operating system's entropy source.
fn entropy() -> u64;

static let mut DEFAULT: Random = Random::new();

/// Restarts the shared generator's sequence from `seed`.
pub fn seed(seed: u64) => DEFAULT.seed(seed);
pub fn getrandbits(k: u32) -> u64 => DEFAULT.getrandbits(k);
pub fn random() -> f64 => DEFAULT.random();
pub fn uniform(a: f64, b: f64) -> f64 => DEFAULT.uniform(a, b);
pub fn randint<T: Integer>(a: T, b: T) -> T => DEFAULT.randint(a, b);
pub fn randrange<T: Integer>(stop: T) -> T => DEFAULT.randrange(stop);
pub fn randrange<T: Integer>(start: T, stop: T, step: T = 1) -> T => DEFAULT.randrange(start, stop, step: step);
pub fn chance(p: f64) -> bool => DEFAULT.chance(p);
pub fn gauss(mu: f64, sigma: f64) -> f64 => DEFAULT.gauss(mu, sigma);
pub fn expovariate(lambd: f64) -> f64 => DEFAULT.expovariate(lambd);
pub fn choice<T>(xs: [T]) -> T => DEFAULT.choice(xs);
pub fn choices<T>(xs: [T], k: usize = 1, weights: [f64] | null = null) -> [T] =>
    DEFAULT.choices(xs, k: k, weights: weights);
pub fn shuffle<T>(xs: [T]) => DEFAULT.shuffle(xs);
pub fn sample<T>(xs: [T], k: usize) -> [T] => DEFAULT.sample(xs, k);
