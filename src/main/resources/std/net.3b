// std::net: IP addresses and TCP and UDP sockets (spec §16).
//
// Sockets are blocking; a server serves each connection on a thread. They live in std::io's
// handle table beside files, so reading, writing and closing go through the same `sys_*` calls,
// and a `TcpStream` reads through the same buffer as a `File`.

use std::io::{IoErr, ClosedErr, Read, Write, Buffered, ReadErr, no_timeout, sys_close, sys_write, sys_write_str, sys_error};
use std::sync::Semaphore;
use std::thread;
use std::thread::CancelledErr;
use std::time::Duration;
/// A read timeout or connect timeout passing (§16); not a `NetErr`.
pub use std::time::TimedOutErr;

// ---- Errors ----

/// A network failure. The subclasses are the failures worth telling apart; any other (an
/// unknown host, say) is a `NetErr` itself, with the system's description. `path` is the
/// address the operation was on.
pub class NetErr : IoErr {
    pub fn new(msg: str, path: str | null = null) -> Self => { ..IoErr::new(msg, path: path) };
}

/// Nothing was listening at the address.
pub class ConnectionRefusedErr : NetErr {
    pub fn new(path: str | null) -> Self => { ..NetErr::new("connection refused", path: path) };
}

/// The peer reset the connection, or closed it while it was being written to.
pub class ConnectionResetErr : NetErr {
    pub fn new(path: str | null) -> Self => { ..NetErr::new("connection reset", path: path) };
}

/// The address to bind is taken.
pub class AddrInUseErr : NetErr {
    pub fn new(path: str | null) -> Self => { ..NetErr::new("address in use", path: path) };
}

/// Text that is not an address; `path` is the text.
pub class AddrParseErr : NetErr {
    pub fn new(text: str) -> Self => { ..NetErr::new("invalid address", path: text) };
}

// Error codes of the `sys_*` calls (negated in their results), after std::io's.
const E_CONN_REFUSED: i64 = 9;
const E_CONN_RESET: i64 = 10;
const E_TIMED_OUT: i64 = 11;
const E_ADDR_IN_USE: i64 = 12;
const E_UNKNOWN_HOST: i64 = 13;

/// The error for `r`, the negative result of a `sys_*` call on `path`.
fn failure(r: i64, path: str | null) -> ReadErr {
    let code = -r;
    if code == E_CONN_REFUSED { return ConnectionRefusedErr::new(path); }
    if code == E_CONN_RESET { return ConnectionResetErr::new(path); }
    if code == E_TIMED_OUT { return TimedOutErr::new(); }
    if code == E_ADDR_IN_USE { return AddrInUseErr::new(path); }
    if code == E_UNKNOWN_HOST { return NetErr::new("unknown host", path: path); }
    return std::io::failure(r, path);
}

/// `()`, or the error if `r` is a `sys_*` failure of a call that cannot time out.
fn check(r: i64, path: str | null) -> () | IoErr | CancelledErr {
    if r < 0 { return no_timeout(failure(r, path)); }
}

/// `()`, or the error if `r` is a `sys_*` failure of a read, which can time out.
fn check_read(r: i64, path: str | null) -> () | ReadErr {
    if r < 0 { return failure(r, path); }
}

/// The error for `r` from a call that makes a socket: any failure but a timeout or
/// cancellation is a `NetErr`.
fn net_failure(r: i64, path: str) -> NetErr | TimedOutErr | CancelledErr {
    let e = failure(r, path);
    if e is NetErr || e is TimedOutErr || e is CancelledErr { return e; }
    return NetErr::new(sys_error(), path: path);
}

// ---- Addresses ----

/// An IPv4 address, printed as four decimal octets: `127.0.0.1`.
pub struct Ipv4Addr : Display {
    pub let octets: [u8; 4];

    /// `127.0.0.1`.
    pub static let LOCALHOST: Ipv4Addr = Ipv4Addr::new(127, 0, 0, 1);
    /// `0.0.0.0`: every local address, when binding.
    pub static let UNSPECIFIED: Ipv4Addr = Ipv4Addr::new(0, 0, 0, 0);

    pub fn new(a: u8, b: u8, c: u8, d: u8) -> Self => { octets: [a, b, c, d] };

    /// Four decimal octets separated by `.`, without leading zeros.
    pub fn parse(s: str) -> Self | AddrParseErr {
        let parts = s.split(".");
        if parts.len != 4 { return AddrParseErr::new(s); }
        let mut octets: [u8; 4] = [0, 0, 0, 0];
        for i in 0..parts.len {
            let p = parts[i];
            if p.len == 0 || p.len > 3 || (p.len > 1 && p[0] == '0') { return AddrParseErr::new(s); }
            let n = decimal(p);
            if n == null || n > 255 { return AddrParseErr::new(s); }
            octets[i] = n as u8;
        }
        return Ipv4Addr { octets };
    }

    /// In `127.0.0.0/8`.
    pub fn is_loopback(self) -> bool => self.octets[0] == 127;
    /// `0.0.0.0`.
    pub fn is_unspecified(self) -> bool => self == Ipv4Addr::UNSPECIFIED;

    pub fn to_str(self) -> str => self.octets.join(".");
}

/// An IPv6 address, printed in the RFC 5952 form: `::1`, `2001:db8::8a2e:370:7334`.
pub struct Ipv6Addr : Display {
    pub let segments: [u16; 8];

    /// `::1`.
    pub static let LOCALHOST: Ipv6Addr = Ipv6Addr::new(0, 0, 0, 0, 0, 0, 0, 1);
    /// `::`: every local address, when binding.
    pub static let UNSPECIFIED: Ipv6Addr = Ipv6Addr::new(0, 0, 0, 0, 0, 0, 0, 0);

    pub fn new(a: u16, b: u16, c: u16, d: u16, e: u16, f: u16, g: u16, h: u16) -> Self
        => { segments: [a, b, c, d, e, f, g, h] };

    /// Eight groups of up to four hexadecimal digits separated by `:`, where `::` stands for
    /// one or more zero groups, and the last two groups may be IPv4 text (`::ffff:10.0.0.1`).
    pub fn parse(s: str) -> Self | AddrParseErr {
        let halves = s.split("::");
        if halves.len > 2 { return AddrParseErr::new(s); }
        let head = groups(halves[0], halves.len == 1);
        let tail: [u16] | null = groups(halves[1], true) if halves.len == 2 else [];
        if head == null || tail == null { return AddrParseErr::new(s); }
        let n = head.len + tail.len;
        if (halves.len == 1 && n != 8) || (halves.len == 2 && n > 7) { return AddrParseErr::new(s); }
        let mut segments: [u16; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
        for i in 0..head.len { segments[i] = head[i]; }
        for i in 0..tail.len { segments[8 - tail.len + i] = tail[i]; }
        return Ipv6Addr { segments };
    }

    /// `::1`.
    pub fn is_loopback(self) -> bool => self == Ipv6Addr::LOCALHOST;
    /// `::`.
    pub fn is_unspecified(self) -> bool => self == Ipv6Addr::UNSPECIFIED;

    /// Lower-case groups without leading zeros, the longest run of two or more zero groups (the
    /// first, if tied) as `::`.
    pub fn to_str(self) -> str {
        let g = self.segments;
        let mut best: usize = 0;
        let mut best_len: usize = 0;
        let mut i: usize = 0;
        while i < 8 {
            let mut j = i;
            while j < 8 && g[j] == 0 { j += 1; }
            if j - i > best_len { best = i; best_len = j - i; }
            i = j + 1 if j > i else i + 1;
        }
        if best_len < 2 { return hex_groups(g, 0, 8); }
        return hex_groups(g, 0, best) + "::" + hex_groups(g, best + best_len, 8);
    }
}

/// An IPv4 or IPv6 address.
pub type IpAddr = Ipv4Addr | Ipv6Addr;

/// An IPv4 address's text (four decimal octets), or else an IPv6 address's.
pub fn parse_ip(s: str) -> IpAddr | AddrParseErr {
    if s.contains(":") { return Ipv6Addr::parse(s); }
    return Ipv4Addr::parse(s);
}

/// An IP address and port, printed as `127.0.0.1:8080` or `[::1]:8080`.
pub struct SocketAddr : Display {
    pub let ip: IpAddr;
    pub let port: u16;

    pub fn new(ip: IpAddr, port: u16) -> Self => { ip, port };

    /// `ip:port`, with an IPv6 address in brackets.
    pub fn parse(s: str) -> Self | AddrParseErr {
        let hp = host_port(s)?;
        let ip = parse_ip(hp.0);
        if ip is AddrParseErr { return AddrParseErr::new(s); }
        if (ip is Ipv6Addr) != hp.2 { return AddrParseErr::new(s); }
        return SocketAddr { ip, port: hp.1 };
    }

    pub fn to_str(self) -> str {
        let ip = self.ip;
        if ip is Ipv6Addr { return f"[{ip}]:{self.port}"; }
        return f"{ip}:{self.port}";
    }
}

/// `host:port` split into the host, the port and whether the host was in brackets.
fn host_port(s: str) -> (str, u16, bool) | AddrParseErr {
    let mut host = s;
    let mut rest = "";
    let bracketed = s.starts_with("[");
    if bracketed {
        let end = s.find("]");
        if end == null { return AddrParseErr::new(s); }
        host = s[1..end];
        rest = s[end + 1..];
    } else {
        let parts = s.split(":");
        if parts.len != 2 { return AddrParseErr::new(s); }
        host = parts[0];
        rest = ":" + parts[1];
    }
    if host.len == 0 || !rest.starts_with(":") || rest.len < 2 || rest.len > 6 || (rest.len > 2 && rest[1] == '0') {
        return AddrParseErr::new(s);
    }
    let port = decimal(rest[1..]);
    if port == null || port > 65535 { return AddrParseErr::new(s); }
    return (host, port as u16, bracketed);
}

/// The value of `s` if it is only decimal digits (at most 5).
fn decimal(s: str) -> u32 | null {
    if s.len == 0 || s.len > 5 { return null; }
    let mut n: u32 = 0;
    for c in s.chars() {
        if !c.is_digit() { return null; }
        n = n * 10 + (c as u32 - '0' as u32);
    }
    return n;
}

/// The groups of one side of `::`, or null if they are not hex groups. `last`: the side ends
/// the address, so its last group may be IPv4 text.
fn groups(s: str, last: bool) -> [u16] | null {
    let mut out: [u16] = [];
    if s == "" { return out; }
    let parts = s.split(":");
    for i in 0..parts.len {
        let p = parts[i];
        if last && i == parts.len - 1 && p.contains(".") {
            let v4 = Ipv4Addr::parse(p);
            if v4 is AddrParseErr { return null; }
            let o = v4.octets;
            out.push((o[0] as u16) << 8 | o[1] as u16);
            out.push((o[2] as u16) << 8 | o[3] as u16);
            return out;
        }
        if p.len == 0 || p.len > 4 { return null; }
        let mut n: u16 = 0;
        for c in p.chars() {
            let d = hex_digit(c);
            if d == null { return null; }
            n = n << 4 | d;
        }
        out.push(n);
    }
    return out;
}

fn hex_digit(c: char) -> u16 | null {
    if c.is_digit() { return (c as u32 - '0' as u32) as u16; }
    let l = c.to_lower();
    if l >= 'a' && l <= 'f' { return (l as u32 - 'a' as u32 + 10) as u16; }
    return null;
}

/// `g[from..to]` in lower-case hex without leading zeros, separated by `:`.
fn hex_groups(g: [u16; 8], from: usize, to: usize) -> str {
    let digits = "0123456789abcdef";
    let mut parts: [str] = [];
    for i in from..to {
        let mut n = g[i];
        let mut s = "";
        loop {
            s = digits[(n & 15) as usize].to_str() + s;
            n >>= 4;
            if n == 0 { break; }
        }
        parts.push(s);
    }
    return parts.join(":");
}

// ---- Names ----

/// The addresses of `host`, from the system's resolver; an address's text is itself.
pub fn lookup(host: str) -> [IpAddr] | NetErr | CancelledErr {
    let ip = parse_ip(host);
    if ip is not AddrParseErr { return [ip]; }
    let mut found: [str] = [];
    let r = sys_lookup(host, found);
    if r < 0 { return no_timeout(net_failure(r, host)); }
    let mut out: [IpAddr] = [];
    for text in found {
        let a = parse_ip(text);
        if a is IpAddr { out.push(a); }
    }
    if out.len == 0 { return NetErr::new("no addresses", path: host); }
    return out;
}

/// The addresses a target stands for: itself, or `host:port`'s host looked up.
fn targets(addr: SocketAddr | str) -> [SocketAddr] | NetErr | CancelledErr {
    if addr is SocketAddr { return [addr]; }
    let hp = host_port(addr)?;
    if hp.2 { return [SocketAddr { ip: Ipv6Addr::parse(hp.0)?, port: hp.1 }]; }
    let mut out: [SocketAddr] = [];
    for ip in lookup(hp.0)? { out.push(SocketAddr { ip, port: hp.1 }); }
    return out;
}

/// Calls `open` at each of `addr`'s addresses until one succeeds: its handle and address, or the
/// last failure (cancellation stops at once).
fn first_of(addr: SocketAddr | str, open: fn(SocketAddr) -> i64) -> (i64, SocketAddr) | NetErr | TimedOutErr | CancelledErr {
    let all = targets(addr)?;
    let mut last: NetErr | TimedOutErr = NetErr::new("no addresses", path: addr.to_str());
    for a in all {
        let h = open(a);
        if h >= 0 { return (h, a); }
        let e = net_failure(h, a.to_str());
        if e is CancelledErr { return e; }
        last = e;
    }
    return last;
}

/// The socket address of handle `h` (its peer's if `peer`), or `fallback` if it has none.
fn addr_of(h: i64, peer: bool, fallback: SocketAddr) -> SocketAddr {
    let a = SocketAddr::parse(sys_addr(h, peer));
    return fallback if a is AddrParseErr else a;
}

/// A timeout in milliseconds for `sys_*`, where 0 is none; a non-positive `t` panics.
fn millis(t: Duration | null) -> i64 {
    if t == null { return 0; }
    if t.nanos <= 0 { panic(f"std::net: timeout must be positive, got {t}"); }
    return (t.nanos + 999_999) / 1_000_000;
}

// ---- TCP ----

/// Which directions `TcpStream::shutdown` ends.
pub enum Shutdown { Read, Write, Both }

/// A socket listening for TCP connections.
pub class TcpListener {
    let handle: i64;     // -1 once closed
    let local: SocketAddr;

    /// Listens at `addr`, a `SocketAddr` or `"host:port"` text; port 0 picks a free port.
    pub fn bind(addr: SocketAddr | str) -> TcpListener | NetErr | CancelledErr {
        let (h, a) = no_timeout(first_of(addr, a => sys_tcp_listen(a.ip.to_str(), a.port)))?;
        return TcpListener { handle: h, local: addr_of(h, false, a) };
    }

    /// The address it listens at, with the port picked if it was bound to port 0.
    pub get fn local_addr(self) -> SocketAddr => self.local;
    pub get fn closed(self) -> bool => self.handle < 0;

    /// Waits for the next connection.
    pub fn accept(mut self) -> TcpStream | IoErr | CancelledErr {
        thread::check()?;
        if self.handle < 0 { return ClosedErr::new(self.local.to_str(), what: "socket"); }
        let h = sys_accept(self.handle);
        if h < 0 { return no_timeout(failure(h, self.local.to_str())); }
        return TcpStream::of(h, self.local);
    }

    /// The connections as they arrive. An error ends the iteration, after being returned as an
    /// element.
    pub fn incoming(mut self) -> Iterator<TcpStream | IoErr | CancelledErr> => Incoming::new(self);

    /// Accepts connections, running `handler` for each on a thread of a scope of its own (§13.4)
    /// and closing the stream when it returns; while `max_connections` handlers are running it
    /// stops accepting, leaving connections in the system's backlog. Once the listener is closed
    /// (from another thread, say), it waits for the running handlers and returns `()`. If its
    /// thread is cancelled, the handlers are cancelled too, and it waits for them and returns
    /// `CancelledErr`. Any other failure to accept is the result, also after waiting.
    pub fn serve(mut self, handler: fn(TcpStream), max_connections: usize | null = null) -> () | IoErr | CancelledErr {
        let slots: Semaphore | null = null if max_connections == null else Semaphore::new(max_connections);
        return thread::scope((s) => {
            loop {
                if slots != null && !slots.acquire() { return CancelledErr::new(); }
                let conn = self.accept();
                if conn is not TcpStream {
                    if slots != null { slots.release(); }
                    if conn is ClosedErr { return; }
                    return conn;
                }
                s.spawn(() => {
                    defer release(slots);
                    let mut stream = conn;
                    defer stream.close();
                    handler(stream);
                });
            }
        });
    }

    /// Stops listening; closing it again does nothing.
    pub fn close(mut self) {
        if self.handle < 0 { return; }
        sys_close(self.handle);
        self.handle = -1;
    }
}

/// Gives back a `serve` slot, if there are slots.
fn release(slots: Semaphore | null) {
    if slots != null { slots.release(); }
}

class Incoming : Iterator<TcpStream | IoErr | CancelledErr> {
    let listener: TcpListener;
    let done: bool = false;

    pub fn new(listener: TcpListener) -> Self => { listener };

    pub fn next(mut self) -> TcpStream | IoErr | CancelledErr | Done {
        if self.done { return Done; }
        let s = self.listener.accept();
        if s is not TcpStream { self.done = true; }
        return s;
    }
}

/// A TCP connection. It reads and writes text (UTF-8) and bytes; reads are buffered, but writes
/// are sent before they return. Close it when done: `defer s.close();`.
pub class TcpStream : Read, Write {
    let io: Buffered;
    let local: SocketAddr;
    let peer: SocketAddr;

    /// Connects to `addr`, a `SocketAddr` or `"host:port"` text, giving up after `timeout` if
    /// one is given.
    pub fn connect(addr: SocketAddr | str, timeout: Duration | null = null) -> TcpStream | NetErr | TimedOutErr | CancelledErr {
        let ms = millis(timeout);
        let (h, a) = first_of(addr, a => sys_tcp_connect(a.ip.to_str(), a.port, ms))?;
        return TcpStream::of(h, a);
    }

    internal fn of(h: i64, fallback: SocketAddr) -> TcpStream {
        let peer = addr_of(h, true, fallback);
        return TcpStream { io: Buffered::new(h, peer.to_str(), failure: failure), local: addr_of(h, false, fallback), peer };
    }

    pub get fn local_addr(self) -> SocketAddr => self.local;
    pub get fn peer_addr(self) -> SocketAddr => self.peer;
    pub get fn closed(self) -> bool => self.io.handle < 0;

    // ---- Reading ----

    /// Everything until the peer closes its side.
    pub fn read(mut self) -> str | IoErr | TimedOutErr | CancelledErr {
        self.demand()?;
        return str::from_utf8(self.io.read_all()?);
    }

    /// The next line without its `\n` or `\r\n`, or null once the peer has closed its side.
    pub fn read_line(mut self) -> str | null | IoErr | TimedOutErr | CancelledErr {
        self.demand()?;
        return self.io.read_line();
    }

    /// Everything until the peer closes its side.
    pub fn read_bytes(mut self) -> [u8] | IoErr | TimedOutErr | CancelledErr {
        self.demand()?;
        return self.io.read_all();
    }

    /// `n` bytes, waiting for them; fewer only if the peer closes its side first.
    pub fn read_bytes(mut self, n: usize) -> [u8] | IoErr | TimedOutErr | CancelledErr {
        self.demand()?;
        return self.io.read_bytes(n);
    }

    // ---- Writing ----

    pub fn write(mut self, s: str) -> () | IoErr | CancelledErr {
        self.demand()?;
        check(sys_write_str(self.io.handle, s), self.peer.to_str())?;
    }

    pub fn write_bytes(mut self, bytes: [u8]) -> () | IoErr | CancelledErr {
        self.demand()?;
        check(sys_write(self.io.handle, bytes), self.peer.to_str())?;
    }

    /// Writes `s` and a `\n`. Writes never time out.
    pub fn write_line(mut self, s: str) -> () | IoErr | CancelledErr => self.write(s + "\n");

    /// Writes are sent before they return, so there is nothing to flush.
    pub fn flush(mut self) -> () | IoErr | CancelledErr => ();

    // ---- Options ----

    /// Makes a read that waits longer than `t` a `TimedOutErr` (the stream stays usable); null
    /// waits forever, as at the start. A zero or negative `t` panics.
    pub fn set_read_timeout(mut self, t: Duration | null) -> () | IoErr | CancelledErr {
        self.demand()?;
        check(sys_set_timeout(self.io.handle, millis(t)), self.peer.to_str())?;
    }

    /// Whether to send small writes at once (`TCP_NODELAY`) rather than gather them.
    pub fn set_nodelay(mut self, on: bool) -> () | IoErr | CancelledErr {
        self.demand()?;
        check(sys_set_nodelay(self.io.handle, on), self.peer.to_str())?;
    }

    /// Ends reading, writing or both; after `Write`, the peer reads the end of the input.
    pub fn shutdown(mut self, how: Shutdown) -> () | IoErr | CancelledErr {
        self.demand()?;
        check(sys_shutdown(self.io.handle, how as i32), self.peer.to_str())?;
    }

    /// Closes the connection; closing it again does nothing.
    pub fn close(mut self) {
        if self.io.handle < 0 { return; }
        sys_close(self.io.handle);
        self.io.handle = -1;
        self.io.clear();
    }

    /// `()` if the thread is not cancelled and the stream is open.
    fn demand(self) -> () | IoErr | CancelledErr {
        thread::check()?;
        if self.io.handle < 0 { return ClosedErr::new(self.peer.to_str(), what: "socket"); }
    }
}

// ---- UDP ----

/// The largest UDP payload over IPv4, and `recv_from`'s default limit.
const MAX_DATAGRAM: usize = 65507;

/// A UDP socket, sending and receiving datagrams.
pub class UdpSocket {
    let handle: i64;     // -1 once closed
    let local: SocketAddr;

    /// Binds to `addr`, a `SocketAddr` or `"host:port"` text; port 0 picks a free port.
    pub fn bind(addr: SocketAddr | str) -> UdpSocket | NetErr | CancelledErr {
        let (h, a) = no_timeout(first_of(addr, a => sys_udp_bind(a.ip.to_str(), a.port)))?;
        return UdpSocket { handle: h, local: addr_of(h, false, a) };
    }

    pub get fn local_addr(self) -> SocketAddr => self.local;
    pub get fn closed(self) -> bool => self.handle < 0;

    /// Sends `bytes` as one datagram to `to`.
    pub fn send_to(mut self, bytes: [u8], to: SocketAddr | str) -> () | IoErr | CancelledErr {
        self.demand()?;
        let dest = targets(to)?[0];
        check(sys_send_to(self.handle, bytes, dest.ip.to_str(), dest.port), dest.to_str())?;
    }

    /// Waits for the next datagram: its bytes (cut to `max`) and its sender.
    pub fn recv_from(mut self, max: usize = MAX_DATAGRAM) -> ([u8], SocketAddr) | IoErr | TimedOutErr | CancelledErr {
        self.demand()?;
        let mut bytes: [u8] = [];
        let mut from: [str] = [];
        check_read(sys_recv_from(self.handle, bytes, max, from), self.local.to_str())?;
        return (bytes, SocketAddr::parse(from[0])?);
    }

    /// Makes `to` the socket's peer, for `send` and `recv`; datagrams from others are dropped.
    pub fn connect(mut self, to: SocketAddr | str) -> () | IoErr | CancelledErr {
        self.demand()?;
        let dest = targets(to)?[0];
        check(sys_udp_connect(self.handle, dest.ip.to_str(), dest.port), dest.to_str())?;
    }

    /// Sends `bytes` as one datagram to the peer set by `connect`.
    pub fn send(mut self, bytes: [u8]) -> () | IoErr | CancelledErr {
        self.demand()?;
        check(sys_write(self.handle, bytes), self.local.to_str())?;
    }

    /// Waits for the next datagram from the peer set by `connect`, cut to `max` bytes.
    pub fn recv(mut self, max: usize = MAX_DATAGRAM) -> [u8] | IoErr | TimedOutErr | CancelledErr {
        self.demand()?;
        let mut bytes: [u8] = [];
        let mut from: [str] = [];
        check_read(sys_recv_from(self.handle, bytes, max, from), self.local.to_str())?;
        return bytes;
    }

    /// As `TcpStream::set_read_timeout`, for `recv` and `recv_from`.
    pub fn set_read_timeout(mut self, t: Duration | null) -> () | IoErr | CancelledErr {
        self.demand()?;
        check(sys_set_timeout(self.handle, millis(t)), self.local.to_str())?;
    }

    /// Closes the socket; closing it again does nothing.
    pub fn close(mut self) {
        if self.handle < 0 { return; }
        sys_close(self.handle);
        self.handle = -1;
    }

    /// `()` if the thread is not cancelled and the socket is open.
    fn demand(self) -> () | IoErr | CancelledErr {
        thread::check()?;
        if self.handle < 0 { return ClosedErr::new(self.local.to_str(), what: "socket"); }
    }
}

// ---- System calls (interpreter intrinsics; reading, writing and closing are std::io's) ----

/// Connects to `ip` (an address's text) and `port`, giving up after `timeout_ms` (0: never); a
/// new handle.
fn sys_tcp_connect(ip: str, port: u16, timeout_ms: i64) -> i64;
fn sys_tcp_listen(ip: str, port: u16) -> i64;
/// Waits for a connection on listener `h`; a new handle.
fn sys_accept(h: i64) -> i64;
fn sys_udp_bind(ip: str, port: u16) -> i64;
fn sys_udp_connect(h: i64, ip: str, port: u16) -> i64;
fn sys_send_to(h: i64, bytes: [u8], ip: str, port: u16) -> i64;
/// Appends the next datagram, cut to `max` bytes, to `buf` and its sender's address to `from`;
/// its length.
fn sys_recv_from(h: i64, buf: [u8], max: usize, from: [str]) -> i64;
/// A read timeout in milliseconds; 0 is none.
fn sys_set_timeout(h: i64, ms: i64) -> i64;
fn sys_set_nodelay(h: i64, on: bool) -> i64;
/// 0 ends reading, 1 writing, 2 both.
fn sys_shutdown(h: i64, how: i32) -> i64;
/// The socket's address (its peer's if `peer`) as `ip:port` or `[ip]:port`; "" if none.
fn sys_addr(h: i64, peer: bool) -> str;
/// Appends the addresses of `host` to `out`; how many.
fn sys_lookup(host: str, out: [str]) -> i64;
