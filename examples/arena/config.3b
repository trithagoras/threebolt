// config.3b — literal union types, narrowing, error values.

pub type Mode = "quick" | "full";

pub struct BadRounds : Error {
    let input: Str;
    pub fn message(self) -> Str => f"expected 'quick', 'full' or a number, got '{self.input}'";
}

fn rounds_for(mode: Mode) -> I32 => match mode {
    "quick" => 3,
    "full" => 10,                       // exhaustive: no `_` needed
};

pub fn parse_rounds(arg: Str) -> I32 | BadRounds {
    if arg is Mode {                    // narrows `arg` from Str to Mode
        return rounds_for(arg);
    }
    return I32::parse(arg) ?? BadRounds { input: arg };
}
