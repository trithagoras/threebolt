use std::thread;

type Result<T> = T | Err;

fn main() -> Result<()> {
    let t = thread::Thread::spawn(thrd);
    t.join()?;
}

fn thrd() -> Result<()> {
    let mut i = 0;
    while i < 10 {
        thread::sleep(1000);
        i += 1;
        println(f"Counter: {i}");
    }
    println("Goodbye.");
}
